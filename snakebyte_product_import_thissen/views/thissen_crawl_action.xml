<odoo>
    <record id="action_start_detailed_crawl" model="ir.actions.server">
        <field name="name">Start Detailed Crawl</field>
        <field name="model_id" ref="model_thissen_crawler"/>
        <field name="state">code</field>
        <field name="code">model.crawl_detailed_pages()</field>
    </record>

    <record id="action_thissen_crawl" model="ir.actions.server">
        <field name="name">Start Crawl</field>
        <field name="model_id" ref="model_thissen_crawler"/>
        <field name="state">code</field>
        <field name="code">
            model.crawl_overview_pages()
        </field>
    </record>

    <record id="action_detailed_crawl_selected" model="ir.actions.server">
        <field name="name">Detailed Crawl Selected</field>
        <field name="model_id" ref="model_thissen_product"/>
        <field name="state">code</field>
        <field name="code">
            action = env['thissen.product'].browse(context.get('active_ids')).detailed_crawl_selected()
        </field>
    </record>
</odoo>
